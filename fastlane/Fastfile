default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :tests do |options|
    # Allow device override via parameter, default to iPhone 16 Pro for CI
    device_name = options[:device] || "iPhone 16 Pro"
    
    run_tests(
      project: "Haishin.xcodeproj",
      scheme: "Haishin",
      device: device_name,
      clean: true,
      code_coverage: true,
      result_bundle: true,
      output_directory: "fastlane/test_output",
      output_types: "junit,html"
    )
  end

  desc "Build the app without running tests"
  lane :build do
    build_app(
      project: "Haishin.xcodeproj",
      scheme: "Haishin",
      skip_codesigning: true,
      skip_archive: true,
      destination: "generic/platform=iOS Simulator"
    )
  end
end
