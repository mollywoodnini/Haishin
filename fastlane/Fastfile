default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :tests do
    run_tests(project: "Haishin.xcodeproj",
              scheme: "Haishin",
              clean: true,
              code_coverage: true,
              result_bundle: true,
              output_directory: "fastlane/test_output",
              output_types: "junit,html")
  end

  desc "Build the app without running tests"
  lane :build do
    build_app(project: "Haishin.xcodeproj",
              scheme: "Haishin",
              skip_codesigning: true,
              skip_archive: true,
              destination: "generic/platform=iOS Simulator")
  end

  desc "Build and upload to TestFlight"
  lane :release do |options|
    # Setup App Store Connect API Key
    api_key = app_store_connect_api_key(key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
                                        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
                                        key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
                                        is_key_content_base64: true,
                                        in_house: false)

    # Use Fastlane's built-in CI setup (creates keychain, installs WWDR cert)
    setup_ci

    # Sync code signing certificates and profiles
    sync_result = match(type: "appstore",
                        readonly: true,
                        api_key: api_key,
                        git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"])

    # Increment build number based on TestFlight
    increment_build_number(build_number: latest_testflight_build_number + 1)

    # Build the app with manual signing (override automatic signing from project)
    build_app(project: "Haishin.xcodeproj",
              scheme: "Haishin",
              export_method: "app-store",
              output_directory: "build",
              output_name: "Haishin.ipa",
              clean: true,
              xcargs: "-allowProvisioningUpdates CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.ninila.haishin-app' DEVELOPMENT_TEAM=7P98753C95",
              export_options: {
                provisioningProfiles: {
                  "com.ninila.haishin-app" => "match AppStore com.ninila.haishin-app"
                }
              })

    # Upload to TestFlight
    upload_to_testflight(skip_waiting_for_build_processing: false,
                         distribute_external: true,
                         groups: options[:groups] || ["Beta Testers"],
                         changelog: options[:changelog] || "New release",
                         notify_external_testers: true)
  end

  desc "Build IPA only (no upload)"
  lane :build_ipa do
    # Setup App Store Connect API Key (needed for Match)
    api_key = app_store_connect_api_key(key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
                                        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
                                        key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
                                        is_key_content_base64: true,
                                        in_house: false)

    # Use Fastlane's built-in CI setup (creates keychain, installs WWDR cert)
    setup_ci

    # Sync code signing certificates and profiles
    match(type: "appstore",
          readonly: true,
          api_key: api_key,
          git_private_key: ENV["MATCH_GIT_PRIVATE_KEY"])

    # Build the app with manual signing (override automatic signing from project)
    build_app(project: "Haishin.xcodeproj",
              scheme: "Haishin",
              export_method: "app-store",
              output_directory: "build",
              output_name: "Haishin.ipa",
              clean: true,
              xcargs: "-allowProvisioningUpdates CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='match AppStore com.ninila.haishin-app' DEVELOPMENT_TEAM=7P98753C95",
              export_options: {
                provisioningProfiles: {
                  "com.ninila.haishin-app" => "match AppStore com.ninila.haishin-app"
                }
              })
  end
end
